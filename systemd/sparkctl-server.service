# Optional: run the unified server (gateway + metrics + dash) at boot on a node.
# Installed (rendered from cluster.yaml) by `sparkctl deploy --init` when server.host is a node or a
# server.hosts entry. Restart=always: `sparkctl serve` restarts it by stopping the process.
[Unit]
Description=sparkctl unified server (gateway + metrics + dash)
Wants=network-online.target
After=network-online.target

[Service]
User={{USER}}
WorkingDirectory={{REMOTE}}
ExecStart={{REMOTE}}/bin/sparkctl serve --foreground
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
